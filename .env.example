APP_HOST=0.0.0.0
# Local dev: APP_PORT. On Render, PORT is injected — APP_PORT is ignored if PORT is set.
APP_PORT=8080
DATABASE_URL=sqlite:///./data/mock.db
LWA_JWT_SECRET=dev-secret-change-me
STRICT_AUTH=false
REPORT_MIN_DELAY_SEC=2
REPORT_MAX_DELAY_SEC=5
DOWNLOAD_URL_TTL_SEC=900
# Local: your dev URL. On Render, omit or set your custom domain; otherwise RENDER_EXTERNAL_URL is used.
PUBLIC_BASE_URL=http://localhost:8080
